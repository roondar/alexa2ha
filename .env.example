HA_WEBHOOK_URL=http://homeassistant.local:8123/api/webhook/CHANGE_ME
AMAZON_URL=https://www.amazon.fr
# alexa_media_player v5.15.6+ JSON cookie file only (pickle is rejected)
COOKIE_PATH=/cookie.cookies
LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=60
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=30
STATE_PATH=/data/state.sqlite3
HEARTBEAT_PATH=/tmp/alexa2ha-heartbeat
